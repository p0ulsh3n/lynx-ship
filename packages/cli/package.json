{
  "name": "@lynxship/cli",
  "version": "0.1.14",
  "description": "Build, sign, store, submit and update LynxJS applications from the terminal.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/p0ulsh3n/lynx-ship.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/p0ulsh3n/lynx-ship/issues"
  },
  "homepage": "https://github.com/p0ulsh3n/lynx-ship/tree/main/packages/cli#readme",
  "keywords": [
    "lynxjs",
    "lynx",
    "mobile",
    "android",
    "ios",
    "ota",
    "build",
    "cli"
  ],
  "files": [
    "dist",
    "README.md",
    "templates"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "lynxship": "dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./runtime-fingerprint": {
      "types": "./dist/runtime-fingerprint.d.ts",
      "import": "./dist/runtime-fingerprint.js"
    },
    "./autolink": {
      "types": "./dist/autolink.d.ts",
      "import": "./dist/autolink.js"
    },
    "./ui/*": {
      "types": "./dist/ui/*.d.ts",
      "import": "./dist/ui/*.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json --pretty false",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1116.0",
    "@aws-sdk/lib-storage": "3.1116.0",
    "@aws-sdk/s3-request-presigner": "3.1116.0",
    "@lynxship/build-orchestrator": "workspace:*",
    "@lynxship/contracts": "workspace:*",
    "@lynxship/db": "workspace:*",
    "@lynxship/signing": "workspace:*",
    "@lynxship/submit": "workspace:*",
    "boxen": "8.0.1",
    "chalk": "5.4.1",
    "cli-progress": "3.12.0",
    "ora": "8.2.0",
    "qrcode-generator": "1.4.4",
    "qrcode-terminal": "0.12.0",
    "qr-code-styling": "1.9.2"
  },
  "devDependencies": {
    "@types/cli-progress": "3.11.6",
    "@types/qrcode-terminal": "0.12.2"
  }
}
