{
  "name": "@lynxship/navigation",
  "version": "0.1.0",
  "description": "Host-neutral navigation contracts and secure deep-link policy for Lynx applications.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/p0ulsh3n/lynx-ship.git",
    "directory": "packages/navigation"
  },
  "files": [
    "dist",
    "README.md",
    "android/build.gradle",
    "android/consumer-rules.pro",
    "android/src",
    "ios/*.podspec",
    "ios/*.h",
    "ios/*.m",
    "ios/*.swift",
    "lynx.lib.json"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@lynxship/contracts": "workspace:*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json --pretty false",
    "codegen": "lynx-autolink-codegen"
  },
  "devDependencies": {
    "@lynx-js/autolink-codegen": "0.4.1"
  }
}
