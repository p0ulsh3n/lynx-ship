{
  "name": "@lynxship/sdk-android",
  "version": "0.1.0",
  "description": "Native Android OTA and reusable Lynx container SDK for LynxShip hosts.",
  "license": "MIT",
  "files": [
    "src",
    "build.gradle",
    "README.md",
    "src/main/AndroidManifest.xml"
  ],
  "repository": {
