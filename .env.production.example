# Copy to .env.production locally. Never commit the copy.
# DATABASE_URL must URL-encode the password and remain private.
DATABASE_URL=postgresql://lynxship:replace-me@postgres:5432/lynxship
POSTGRES_PASSWORD=replace-with-a-long-random-password
REDIS_PASSWORD=replace-with-a-different-long-random-password
REDIS_URL=redis://:replace-with-a-different-long-random-password@queue:6379
LYNXSHIP_TOKEN=replace-with-a-long-random-api-token
R2_ENDPOINT=https://replace-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace-with-least-privilege-r2-key
R2_SECRET_ACCESS_KEY=replace-with-r2-secret
R2_BUCKET=lynxship-production
LYNXSHIP_RATE_LIMIT=120
