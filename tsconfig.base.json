{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "baseUrl": ".",
    "paths": {
      "@lynxship/api": ["packages/api/src/index.ts"],
      "@lynxship/auth": ["packages/auth/src/index.ts"],
      "@lynxship/build-orchestrator": [
        "packages/build-orchestrator/src/index.ts"
      ],
      "@lynxship/build-providers": ["packages/build-providers/src/index.ts"],
      "@lynxship/cli": ["packages/cli/src/index.ts"],
      "@lynxship/cli/config": ["packages/cli/src/config.ts"],
      "@lynxship/cli/runtime-fingerprint": [
        "packages/cli/src/runtime-fingerprint.ts"
      ],
      "@lynxship/cli/autolink": ["packages/cli/src/autolink.ts"],
      "@lynxship/cli/frameworks": ["packages/cli/src/frameworks.ts"],
      "@lynxship/cli/ui/*": ["packages/cli/src/ui/*"],
      "@lynxship/contracts": ["packages/contracts/src/index.ts"],
      "@lynxship/plugin-api": ["packages/plugin-api/src/index.ts"],
      "@lynxship/db": ["packages/db/src/index.ts"],
      "@lynxship/queue": ["packages/queue/src/index.ts"],
      "@lynxship/signing": ["packages/signing/src/index.ts"],
      "@lynxship/storage": ["packages/storage/src/index.ts"],
      "@lynxship/submit": ["packages/submit/src/index.ts"],
      "@lynxship/worker-agent": ["packages/worker-agent/src/index.ts"]
    }
  }
}
